											"name": "K11: 仆人宿舍",
											"type": "entries",
											"id": "020",
											"entries": [
												{
													"type": "insetReadaloud",
													"id": "021",
													"entries": [
														"这个房间充满了灰尘和蛛网。三组上下铺床靠在东墙上，它们的稻草床垫严重腐烂。"
													]
												}
											]
										},
