									"name": "深水城（东北部）",
									"type": "entries",
									"id": "01c",
									"page": 4,
									"entries": [
										"深水城防御区（参见{@area 地图 1.5|018|x}）的攻城武器是一门小型青铜炮，上面镶嵌着奥术符文，并安装在一个重型三脚架上。它发射出噼啪作响的电球。",
										{
											"ENG_name": "Storm Cannon",
											"name": "风暴火炮",
											"type": "statblock",
											"tag": "object",
											"source": "HBTD",
											"page": 4,
											"style": "narrow"
										}
									]
