		{
			"ENG_name": "Brontodon",
			"name": "雷龙",
			"source": "PSX",
			"_copy": {
				"ENG_name": "Dinosaurs",
				"name": "恐龙",
				"source": "PSX",
				"_mod": {
					"entries": {
						"mode": "prependArr",
						"items": {
							"type": "entries",
							"entries": [
								{
									"ENG_name": "The Rumbling Herds",
									"name": "轰鸣的兽群",
									"type": "entries",
									"page": 27,
									"entries": [
										"最大的恐龙是巨大的长颈食草动物，以高大树木的叶子为食。这些恐龙的巨大体型意味着单独一只\u2014\u2014通常是一只年轻的、年老的或受伤的，与群体分离的\u2014\u2014可以养活一整群较小的掠食者。壮丽的阿尔提斯龙在阳光海岸的平原和稀疏的森林中漫步，以树顶为食。布鲁顿龙成群结队地旅行，当它们加速时，巨大的重量使得地面震动。使用{@book 瓦罗怪物指南|VGM}中的{@creature 雷龙|VGM}数据来表示这些生物。"
									]
								}
							]
						}
					}
				}
			},
