		{
			"ENG_name": "Ashenwights",
			"name": "灰烬尸妖",
			"source": "PaBTSO",
			"entries": [
				{
					"type": "section",
					"entries": [
						{
							"ENG_name": "Ashenwights",
							"name": "灰烬尸妖",
							"type": "entries",
							"entries": [
								"惨死于受遥远国度所腐化之地的类人生物可能会复生为一只灰烬尸妖。这些骇人不死者皮肤枯槁，眼瞳中时常闪烁着异界力量。"
							]
						}
					]
				}
			],
			"images": [
				{
