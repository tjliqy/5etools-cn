					"height": 848
				}
			]
		},
		{
			"ENG_name": "Brain Breaker",
			"name": "碎脑者",
			"source": "PaBTSO",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"碎脑者者看起来像巨大的大脑，有着粗壮的腿，它们穿着由Ilvaash的符文（触手、大脑和让人想起颚部的锯齿状线条的结）相互连接的钢制盔甲。"
					]
				}
			]
		},
