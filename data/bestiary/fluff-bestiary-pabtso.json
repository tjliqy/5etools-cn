		{
			"ENG_name": "Feral Ashenwight",
			"name": "凶残灰烬尸妖",
			"source": "PaBTSO",
			"_copy": {
				"ENG_name": "Ashenwights",
				"name": "灰烬尸妖",
				"source": "PaBTSO",
				"_mod": {
					"entries": {
