		{
			"ENG_name": "Humanoid Mutate",
			"name": "类人异变体",
			"source": "PaBTSO",
			"_copy": {
				"ENG_name": "Mutates",
				"name": "异变体",
				"source": "PaBTSO",
				"_mod": {
					"entries": {
						"mode": "prependArr",
						"items": {
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"当遥远国度的影响作用于人形生物时，由此产生的生物可能是噩梦中的事物。无数的蹼状翅膀沿着这个突变体的身体杂乱无章地生长出来。它的皮肤变得潮湿，像蜥蜴一样光滑。",
										"一些智能人形突变体在暴露于遥远国度之前保留了他们的人格。有些人，被异世界力量的诱惑所驱使，寻求这种转变，成为邪恶的先知和使者。其他人则找到了魔法方法恢复到他们之前的形式。"
									]
								}
