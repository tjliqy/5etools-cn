					"height": 1000
				}
			]
		},
		{
			"ENG_name": "Medani Inquisitive",
			"name": "梅丹尼调查员",
			"source": "EFA",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"梅丹尼家族最受珍视的调查员，这个主要由科拉瓦组成的家族，运用他们的龙纹和敏锐的智力来预见来自任何方向的威胁。其中一些成员属于一个名为石化蜥蜴凝视的秘密组织，致力于追捕在终末战争期间犯下暴行的逃亡战犯。"
					]
				}
			],
			"images": [
				{
