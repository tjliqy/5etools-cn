			"ENG_name": "Boromar Smuggler",
			"name": "波罗马走私者",
			"source": "EFA",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"受雇于波罗马氏族的走私者（多为半身人）以难以抓捕而臭名昭著。这些行动敏捷的罪犯在萨恩全城往来穿梭，贩运从违禁麻醉品到非法奥术武器的一切物资。"
					]
				}
			],
