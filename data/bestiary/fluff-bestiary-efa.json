						"path": "bestiary/EFA/Jorasco Medic.webp"
					},
					"width": 504,
					"height": 1000
				}
			]
		},
		{
			"ENG_name": "Kundarak Warden",
			"name": "昆达拉克卫士",
			"source": "EFA",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"一些昆达拉克家族的龙纹继承人（主要是矮人）担任家族宝库和仓库的个人护卫，甚至其声名狼藉的监狱恐惧要塞。一些还担任神秘的Ghorad'din的代理人，这是一个秘密的刺客和间谍组织，除了家族成员外鲜为人知。昆达拉克卫士擅长绕过安全措施以及加强它们。"
					]
				}
			],
			"images": [
				{
					"type": "image",
					"href": {
						"type": "internal",
						"path": "bestiary/EFA/Kundarak Warden.webp"
					},
					"width": 652,
					"height": 1000
