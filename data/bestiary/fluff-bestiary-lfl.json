		{
			"ENG_name": "Noggle Ransacker",
			"name": "诺格劫掠者",
			"source": "LFL",
			"_copy": {
				"ENG_name": "Noggles",
				"name": "诺格",
				"source": "LFL",
				"_mod": {
					"entries": {
						"mode": "prependArr",
						"items": [
							{
								"type": "section",
								"entries": [
									"诺格从不扒窃\u2014\u2014它们直接抢劫。尽管行为鲁莽，许多诺格还是会选择戴上面具、头巾或其他简易伪装来遮掩身份。"
								]
							}
						]
					}
				}
			},
