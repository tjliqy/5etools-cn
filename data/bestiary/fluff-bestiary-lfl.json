		{
			"ENG_name": "Merrow Haranguer",
			"name": "梅洛演说家",
			"source": "LFL",
			"_copy": {
				"ENG_name": "Merrow",
				"name": "梅洛",
				"source": "LFL",
				"_mod": {
					"entries": {
						"mode": "prependArr",
						"items": [
							{
								"type": "section",
								"entries": [
									"在洛温的大多数梅洛都是梅洛演说家，他们试图用大量刻薄的批判之语压制他人，来达成自己的目标。"
								]
							}
						]
					}
				}
			},
