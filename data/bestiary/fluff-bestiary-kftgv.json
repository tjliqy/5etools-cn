{
	"monsterFluff": [
		{
			"ENG_name": "Animatronic Allosaurus",
			"name": "机械动画异龙",
			"source": "KftGV",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"异特龙是一种体型庞大、力量强大、速度极快的食肉恐龙。它几乎可以在开阔地面上追捕任何猎物，并用其锋利的爪子猛扑将猎物拉倒。"
					]
				}
			]
		},
		{
			"ENG_name": "Ashen Animated Armor",
			"name": "灰烬活化盔甲",
			"source": "KftGV",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"这套魔法活化的板甲在移动时发出叮当作响的声音，撞击和摩擦，就像一个倒下的骑士的怨仇灵魄。"
					]
				}
			]
		},
		{
			"ENG_name": "Ashen Flying Sword",
			"name": "灰烬飞行剑",
			"source": "KftGV",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"一把被魔法赋予生命的飞行剑在空中舞动，像一个不会受伤的战士一样战斗。"
					]
				}
			]
		},
		{
			"ENG_name": "Ashen Knight",
			"name": "灰烬骑士",
			"source": "KftGV",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"骑士是向统治者、宗教团体和崇高事业宣誓服务的战士。一个骑士的阵营决定了他遵守誓言的程度。无论是执行任务还是巡逻领地，骑士通常会带着包括扈从和雇佣兵在内的随行人员，这些人是平民。"
					]
				}
			]
		},
		{
			"ENG_name": "Ashen Veteran",
			"name": "灰烬老兵",
			"source": "KftGV",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"老兵是专业的战士，他们为了金钱或保护他们信仰或珍视的东西而拿起武器。他们的行列包括长期服役后退役的士兵，以及从未为他人服务只为自己的战士。"
					]
				}
			]
		},
		{
			"ENG_name": "Charmayne Daymore",
			"name": "夏梅恩·德墨尔",
			"source": "KftGV",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"作为一位强大的施法者，夏梅恩嫉妒国王既富有激情又有亲和力。她渴望占有这些品质，于是煞费苦心地创造了仪式来榨干杰哈索王的生命力和魅力，并将它们注入到自己身上。然而，魔法只增强了她的贪婪的嫉妒，夏梅恩越是从杰哈索王手中夺取力量，她越是渴望力量，甚至在睡梦中杀害了自己的同僚雷吉恩。",
						"当她意识到加拉辛的人民不像爱戴国王那样爱戴她时，夏梅恩变得恼羞成怒。她用魔法下了杰哈索的心脏，同时保持了它的生命。然后，她用那颗仍在跳动的心脏作为仪式的法器，开始摧毁加拉辛。"
					]
				}
			]
		},
		{
			"ENG_name": "Clockwork Defender",
			"name": "发条防御者",
			"source": "KftGV",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"发条防御者是一种外形与猎犬相似的四足构装生物。它的眼睛会发光，可以发射强烈但无害的光束。它不知疲倦地保卫着它的创造者想要的东西，而且它可以被它的创造者设定为不攻击某些类型的生物。"
					]
				}
			]
		},
		{
			"ENG_name": "Clockwork Observer",
			"name": "发条观察者",
			"source": "KftGV",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"发条观察者为其创造者充当空中探子。它看起来像一个机械的、柚子大小的球体，悬浮在轻声嗡鸣的螺旋桨叶片下。球体中嵌入了敏锐的水晶眼，使观察者能够同时看到多个方向。当它察觉到一些令人不安的东西时，观察者会发出一声在300英尺范围内都能听到的尖叫。观察者还可以通过心灵感应将它所发现的东西转达给它的创造者，只要两者相距1英里以内。"
					]
				}
			]
		},
