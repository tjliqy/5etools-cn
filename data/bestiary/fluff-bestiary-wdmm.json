		{
			"ENG_name": "Shadow Assassin",
			"name": "幽影刺客",
			"source": "WDMM",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"影刺客看起来像是一个不死生物阴影（如{@i 怪物图鉴}中所述），它挥舞着同样由阴影构成的短剑。它的存在只是为了杀死生者。"
									]
