						"path": "bestiary/WDMM/Muiral.webp"
					},
					"width": 1000,
					"height": 1357,
					"credit": "Sidharth Chaturvedi"
				}
			]
		},
		{
			"ENG_name": "Nester",
			"name": "内斯特",
			"source": "WDMM",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"漂浮的骷髅头和悬挂的骷髅手臂是他唯一的残余；它们移动起来就像附着在一具{@condition 隐形}的身体上。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Preeta Kreepa",
			"name": "普丽塔·克里帕",
			"source": "WDMM",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"法师们将一生都投入到魔法的学习和实践中。善良阵营的法师为贵族和其他掌权者提供建议，而邪恶阵营的法师则居住在孤立的地方进行不受干扰的不可告人实验。"
									]
								},
								{
									"type": "section",
									"entries": [
										"Preeta 曾是哈拉斯特的学徒之一，阿尔克图里亚的助手，直到阿尔克图里亚将她变成了一个怪物般的恐怖存在。Preeta 看起来像是一个老妇人，她的眼窝中长出了两个巨眼触须。她的嘴巴异常巨大，是正常大小的两倍，里面充满了锋利的尖牙。她穿着一件剥下来的、滑腻的、半透明的寇涛鱼人皮肤作为斗篷。"
									]
								}
							]
						}
					]
				}
			]
		},
