		{
			"ENG_name": "Asharra",
			"name": "阿莎尔",
			"source": "ToA",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"鸟羽人驰骋于呼啸涡旋之间\u2014\u2014这道由狂烈罡风与滂沱骤雨织就的无尽风暴，环抱着气元素位面中那片安宁的阿夸国度。这些鸟形类人生物在空中巡逻以守护家园的风之边境，抵御来自土元素位面的入侵者，譬如它们的死敌\u2014\u2014石像鬼。"
									]
								},
								{
									"ENG_name": "Biography",
									"name": "传记",
									"type": "entries",
									"entries": [
										"基尔·萨巴隐修地的传奇长老。人们称她为老师，并将她尊为活圣人。阿莎尔聪明、有抱负，有点支配欲，但并不残忍或麻木。"
									]
								}
							]
						}
					]
				}
			],
