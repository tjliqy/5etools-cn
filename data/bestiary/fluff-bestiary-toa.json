		{
			"ENG_name": "Acererak",
			"name": "阿瑟瑞克",
			"source": "ToA",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"阿瑟瑞克是一位穿行于各个世界、以吞噬冒险者的灵魂为乐的大巫妖，他将这些冒险者引诱到遍布陷阱的地下城中，使他们遭受可怕的死亡。失落的奥姆城地下就是一座这样的地下城。这座地下城被称为九神之墓，因为阿瑟瑞克杀死了九名伪神，并将k们封印于其中。最近，他制造了一个叫做易魂装置的不死生物装置，把它藏在了九神之墓的中心。"
									]
								}
							]
						}
					]
				},
				{
					"ENG_name": "Acererak's Traits",
					"name": "阿瑟瑞克的特质",
					"type": "list",
					"style": "list-hang-notitle",
					"items": [
						{
							"ENG_name": "Ideal",
							"name": "理念",
							"type": "item",
							"entries": [
								"\"当我可以成为神的创造者时，为什么要成为神？\""
							]
						},
						{
							"ENG_name": "Bond",
							"name": "牵挂",
							"type": "item",
							"entries": [
								"\"我建造地下城以诱捕并杀死强大的冒险者。他们的死亡与灵魂将成为我的养料。\""
							]
						},
						{
							"ENG_name": "Flaw",
							"name": "缺陷",
							"type": "item",
							"entries": [
								"\"我往往会低估敌人的决心。\""
							]
						}
					]
				}
			],
