										"col-2 text-center",
										"col-10"
									],
									"rows": [
										[
											"1\u20132",
											"{@creature 活体雷鸣波|AU}"
										],
										[
											"3\u20134",
											"{@creature 活体浓酸球|AU}"
										],
										[
											"5",
											"{@creature 活体寒冰锥|AU}"
										]
									]
								},
								"现在对统计数据块做以下修改：",
								{
									"type": "list",
									"items": [
										{
											"ENG_name": "Damage Immunity",
											"name": "伤害免疫",
											"type": "item",
											"entry": "将活化法术的伤害{@variantrule 免疫|XPHB}替换为对所选法术所造成的一种（或多种）伤害类型的{@variantrule 免疫|XPHB}。"
										},
										{
											"ENG_name": "Magical Strike",
											"name": "魔法打击",
											"type": "item",
											"entry": "将\"魔法打击\"造成的伤害类型改为所选法术造成的伤害类型之一。"
										},
										{
											"ENG_name": "Spell Mimicry",
											"name": "法术模拟",
											"type": "item",
											"entry": "将\"法术模拟\"的效应替换为所选法术的效应。若该法术需要豁免检定，使用\"法术模拟\"的法术豁免DC。若该法术涉及攻击检定，使用活化法术\"魔法打击\"的攻击加值。"
										}
									],
									"style": "list-hang-notitle"
								},
								"例如，若你将{@spell 火球术|XPHB}（一道3环法术）转化为活化法术，请定制{@creature 活体浓酸球|AU}的统计数据块。活体火球术具有火焰伤害（而非强酸伤害）的{@variantrule 免疫|XPHB}，其\"魔法打击\"造成火焰伤害，并以\"法术模拟\"复现{@i 火球术}。"
							]
						}
					]
				}
			]
