		{
			"ENG_name": "Nightsea Chil-liren",
			"name": "夜海奇利伦",
			"source": "JttRC",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"贾尼亚是由在渡鸦通道期间逃入大海的贾纳人的后代所居住。贾纳人的变形术魔法和夜海本身的魔力赋予了这些人在水下生活的能力。现在被称为夜海之子的贾尼亚人看起来与贾纳人相似，但他们的棕色皮肤常常带有灰色的色调，鳗鱼状的鳍沿着他们的手臂和腿延伸。"
					]
				}
