						"path": "bestiary/GoS/Locathah.webp"
					},
					"width": 1000,
					"height": 859,
					"credit": "Shawn Wood"
				}
			]
		},
		{
			"ENG_name": "Master Refrum",
			"name": "大师瑞弗拉姆",
			"source": "GoS",
			"images": [
				{
					"type": "image",
					"href": {
						"type": "internal",
						"path": "bestiary/GoS/Master Refrum.webp"
					},
					"width": 1000,
					"height": 1000,
					"credit": "Joachim Barrum"
				}
			]
		},
		{
			"ENG_name": "Maw of Sekolah",
			"name": "瑟寇拉之喉",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"通过仪式和潮汐魔法从海洋的阴暗深处召唤出来，瑟寇拉之口在《最终敌人》中作为饥饿的鲨华鱼人神的化身出现。这个巨大的双头鲨鱼以鲨华鱼人人捕获并作为贡品献上的有感知生物为食。鲨华鱼人女祭司用宝石带和抛光的头骨装饰瑟寇拉之口的鳍。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Merfolk Salvager",
			"name": "人鱼打捞者",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"这些经验丰富的战士擅长搜寻深海中的沉船和遗迹，他们使用类似刺剑的活珊瑚制成的武器帮助保护他们的族人。这些打捞者在搜寻任务中护送其他海族，利用他们敏锐的感官来探测危险。他们在《邓沃特的危险》中与蜥蜴人结盟。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Minotaur Living Crystal Statue",
			"name": "活化牛头人水晶像",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"通过强大的魔法赋予生命，一个大型、粗糙雕刻的水晶牛头人守卫着修道院岛的隧道。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Monstrous Peryton",
			"name": "庞巨鹿鹰兽",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"作为海岸的恐怖和塔默劳特命运中Firewatch岛最近的祸害，这种大型的鹿鹰捕食船只和沿海社区。它建造了无数的巢穴来标记它的领地。"
									]
								}
							]
						}
					]
				}
			],
			"images": [
				{
					"type": "image",
