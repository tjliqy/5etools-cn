		},
		{
			"ENG_name": "Mr. Dory",
			"name": "多利先生",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"统治斯泰尔斯的四位议员之一，多里先生将他被诅咒的本质公然隐藏起来。他罕见的、对液体敏感的\"皮肤状况\"实际上是与创造斯库姆的阿波洛斯（aboleth）疾病相同的一种形式，尽管多里的病情并不严重，他已经设法保留了自己的自由意志。"
									]
								}
							]
						}
					]
				}
			],
			"images": [
				{
					"type": "image",
					"href": {
						"type": "internal",
						"path": "bestiary/GoS/Mr. Dory.webp"
					},
					"width": 593,
					"height": 800,
					"credit": "Joachim Barrum"
				}
			]
		},
		{
			"ENG_name": "Oceanus",
			"name": "俄申努斯",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"在被捕获之前，这位海精灵被指派调查《盐沼泽的邪恶秘密》中海鬼的行动。Oceanus是一个聪明且足智多谋的精灵，他非常愿意加入那些拥有勇敢之心和良好意图的冒险者。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Pirate Bosun",
			"name": "海盗水手长",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"大副（或船员长）负责组织船上的货物和船员。大副是有能力的战士，他们搬运货物和施以打击的经验使他们成为难以对付的对手。在《盐沼的邪恶秘密》中，Foul Frithoff是保护走私船上货物的大副。自从一次严重的事故之后，他一直用一个钩子代替一只手臂的末端。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Pirate Captain",
			"name": "海盗船长",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"海盗船长们在海上度过一生，通过血腥和大胆的方式赢得并保持指挥权。船长们令人印象深刻的剑术和尖锐的话语在船员中既激发了信心也引发了恐惧。Sigurd 'Snake Eyes' 是《Saltmarsh的邪恶秘密》中领导一群走私者的海盗船长。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Pirate Deck Wizard",
			"name": "海盗甲板法师",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"这些盐渍的魔法实践者既博学又迷信。海盗船的船员通常会让甲板法师有较大的活动空间，因为他们会使用魔法在船上各处移动，并释放他们的咸水魔法对抗攻击者。《盐沼的险恶秘密》中的海鬼号船是名为Punketah的海盗甲板法师的家。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Pirate First Mate",
			"name": "海盗大副",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"这些务实的水手是海盗船船长的可靠盟友。退役士兵和训练有素的雇佣兵经常在海盗船上找到工作作为大副。在《盐沼泽的邪恶秘密》中，血腥的比约恩担任\"海鬼\"号上的第一大副。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Rip Tide Priest",
			"name": "裂潮祭司",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"裂潮教派的祭司们秘密地聚集在阴谋集团中，进行黑暗仪式，以荣耀奥赫德拉，邪恶水元素的公主，作为水的破坏力的化身。他们相信，使用水来杀死敌人，例如通过仪式性的溺水，可以获得奥赫德拉的青睐。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Sahuagin Blademaster",
			"name": "鲨华大剑师",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"作为无数战役中狡猾的老手，鲨华鱼人剑术大师用被击败敌人的骨头装饰盔甲。如《最终之敌》所述，鲨华鱼人剑术大师通常作为军官服役于鲨华鱼人军队中。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Sahuagin Champion",
			"name": "鲨华勇士",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"那些通过英勇行为证明自己的鲨华鱼人战士被授予头衔和地位。鲨华鱼人冠军经常在鲨华鱼人军队中担任副官，就像在《The Final Enemy》中一样。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Sahuagin Coral Smasher",
			"name": "鲨华珊瑚粉碎者",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"在《The Final Enemy》中作为前线的重击手，珊瑚粉碎者是从最强壮的鲨华鱼人战士中挑选出来的。他们的身体力量克服了水的阻力，他们以同样的热情挥舞着锤子攻击建筑和敌人。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Sahuagin Deep Diver",
			"name": "鲨华深潜者",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"这些强大的鲨华鱼人人，在《最终敌人》中被发现，通过瑟寇拉的神圣魔法被改造，使他们能更好地探索海洋最黑暗的深处。在水外，他们紧贴阴影，充当猎人和刺客。一个可以照亮的长鳞片诱饵从深潜者的额头延伸出来。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Sahuagin Hatchling Swarm",
			"name": "鲨华鱼人幼体集群",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"在《最终敌人》中翻腾的海水中，这些鲨华鱼人幼崽的群体对它们遇到的任何生物都是危险的。其他的鲨华鱼人会避开这些群体，而个体成员则相互吞噬，直到只剩下最强壮的幼崽存活下来，成长为成熟的鲨华鱼人。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Sahuagin High Priestess",
			"name": "鲨华高阶女祭司",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"鲨华鱼人的高级女祭司是所有瑟寇拉信徒中最虔诚和最凶猛的。她手持一根镶嵌着锋利鲨鱼牙齿的法杖，可以在《The Final Enemy》中看到她领导黑暗仪式。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Sahuagin Wave Shaper",
			"name": "鲨华塑涛者",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"这些弯腰驼背、扭曲变形的鲨华鱼人人将自己的肉体献给了瑟寇拉的变异魔法。波形塑造者为鲨华鱼人武装力量增添了元素魔法（正如在《最终敌人》中所见），并且喜欢制造破坏性的漩涡。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Sanbalet",
			"name": "桑巴莱特",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"在《盐沼的邪恶秘密》中，桑巴莱特是一个走私团伙陆上部分的头目。他是一个狡猾的自恋者，对幻觉和心灵控制感兴趣。他保护着存放在闹鬼房子下的洞穴里的走私品。"
									]
								}
							]
						}
