		{
			"ENG_name": "Giant Coral Snake",
			"name": "巨珊瑚蛇",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"这些色彩鲜艳的蛇类在陆地和水中都感到舒适，以其强烈且具有幻觉效果的毒液而闻名。它们最常被发现在沿海洞穴中。在塔默劳特的命运中，修道院的废弃大厅里，这些巨大的蛇类以任何穿过它们路径的生物为食。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Giant Sea Eel",
			"name": "巨海鳗",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"潜伏在海洋黑暗水域的蛇形捕食者，这些海带色的野兽为洛克塔哈（包括在丹沃特的危险之地发现的那些）提供守卫和坐骑服务。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Harpy Matriarch",
			"name": "鸟妖女族长",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"在《塔默罗特的命运》中，这只灰羽的鹰身女妖族长乐于观看其族群为腐肉争吵。她周围环绕着一群看起来像骨架海鸟的魔法精灵。"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"ENG_name": "Juvenile Kraken",
			"name": "幼体克拉肯",
			"source": "GoS",
			"entries": [
				{
					"type": "entries",
					"entries": [
						{
							"type": "entries",
							"entries": [
								{
									"type": "entries",
									"entries": [
										"隐藏在斯泰斯附近的深暗水下坑中，这个生物带有黑暗之神萨里斯敦疯狂的标志。它每天都在变得更加独立，梦想着摆脱其阿波洛斯的束缚，将自己的邪恶意志施加于海洋。"
									]
								}
							]
						}
					]
				}
			],
