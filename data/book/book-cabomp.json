											]
										},
										{
											"ENG_name": "Picot Stitch (picot):",
											"name": "皮科特针法 (picot):",
											"type": "item",
											"entries": [
												"根据图解钩2或3个锁针，在前一个针目的前半针上钩一个引拔针。"
											]
										},
										{
											"ENG_name": "Popcorn Stitch (popcorn):",
											"name": "爆米花针（爆米花）：",
											"type": "item",
											"entries": [
