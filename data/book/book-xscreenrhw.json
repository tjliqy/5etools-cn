											"{@action 攻击|XPHB}",
											"使用武器发动攻击或发动{@variantrule 徒手打击|XPHB}"
										],
										[
											"{@action 疾走|XPHB}",
											"在回合余下的时间里，给予自己等同于自身{@variantrule 速度|XPHB}的额外移动力。"
										],
										[
											"{@action 撤离|XPHB}",
