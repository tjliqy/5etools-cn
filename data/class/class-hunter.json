	"classFeature": [
		{
			"ENG_name": "Hunter Subclass",
			"name": "猎人子职",
			"source": "WoW",
			"className": "猎人",
			"classSource": "WoW",
			"level": 3,
			"entries": [
				"你获得一个自选的猎人子职。子职是一种专精方向，在特定猎人等级给予你特性。在余下的生涯中，你获得子职中所有等级不高于你猎人等级的特性。"
			],
			"translator": "Kiwee"
		},
		{
			"ENG_name": "Subclass Feature",
			"name": "子职特性",
			"source": "WoW",
			"className": "猎人",
			"classSource": "WoW",
			"level": 6,
			"entries": [
				"你获得一个来自你猎人子职的特性。"
			],
			"translator": "Kiwee"
		}
	],
	"subclassFeature": [
		{
			"ENG_name": "Pet Specialization",
			"name": "宠物专精",
			"source": "WoW",
			"className": "猎人",
			"classSource": "WoW",
			"subclassShortName": "驯兽师",
			"subclassSource": "WoW",
			"level": 6,
			"header": 2,
			"entries": [
				"对拥有{@subclass 驯兽师|猎人|WoW|WoW}子职的猎人而言，此特性取代{@classFeature 越野|游侠|XPHB|6}特性。",
				"当你的{@subclassFeature 原初伴侣|游侠|XPHB|驯兽师|XPHB|3|XPHB}特性的野兽处于你 60 尺内时，你根据该野兽的宠物科及其专精（见\"{@book 猎人的宠物|WoW|1|Hunter Pets}\"）获得以下收益之一。",
				{
					"ENG_name": "Cunning",
					"name": "狡诈",
					"type": "entries",
					"entries": [
						"你的{@variantrule 速度|XPHB}与你的原初野兽的所有速度提高 10 尺。此外，你的原初野兽可以用它的动作施展{@spell 行动自如|XPHB}，无需任何法术成分，影响它自身与你（如果你在射程内）。一旦如此做，它须等你完成{@variantrule 长休|XPHB}后才能再次如此做。"
					]
				},
				{
					"ENG_name": "Ferocity",
					"name": "狂怒",
					"type": "entries",
					"entries": [
						"当你的原初野兽处于{@status 浴血|XPHB}状态且以野兽之击命中时，你与原初野兽各回复等同于你感知调整值的{@variantrule 生命值|XPHB}。此外，你的原初野兽可以用它的动作施展{@spell 加速术|XPHB}，无需任何法术成分，影响它自身与你（如果你在射程内）。一旦如此做，它须等你完成{@variantrule 长休|XPHB}后才能再次如此做。"
					]
				},
				{
					"ENG_name": "Tenacity",
					"name": "坚韧",
					"type": "entries",
					"entries": [
						"你的{@variantrule 生命值|XPHB|生命值}上限增加6点。每当你获得一个游侠等级，你的{@variantrule 生命值|XPHB|生命值}上限额外增加1点{@variantrule 生命值|XPHB|生命值}。你的原始野兽的{@variantrule 生命值|XPHB|生命值}上限也会增加等同于你游侠等级的点数。此外，你的原始野兽可以使用它的动作施放{@spell 石肤术|XPHB}而无需任何法术成分，效果作用于它自身和你（如果你在范围内）。一旦它这样做，直到你完成一次{@variantrule 长休|XPHB}前，它不能再这样做。"
					]
				}
			],
			"translator": "Kiwee"
		},
		{
			"ENG_name": "Roving",
			"name": "漫游",
			"source": "WoW",
			"className": "猎人",
			"classSource": "WoW",
			"subclassShortName": "猎人",
			"subclassSource": "WoW",
			"level": 6,
			"header": 2,
			"entries": [
				"只要你未着装重甲，你的{@variantrule 速度|XPHB}提升 10 尺。你也获得{@variantrule 攀爬速度|XPHB}和{@variantrule 游泳速度|XPHB}（等于你的{@variantrule 速度|XPHB}）。"
			],
			"translator": "Kiwee"
		}
	]
