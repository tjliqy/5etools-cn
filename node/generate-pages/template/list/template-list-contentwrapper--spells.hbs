<div id="contentwrapper" class="view-col{{#if styleContentWrapperAdditional}} {{styleContentWrapperAdditional}}{{/if}}">
	{{> "listSublistContainer" }}

	{{> "listStatsTabs" }}

	{{> "listWrpPagecontent" }}

	<div class="ve-flex-vh-center ve-mt-2 ve-print__hidden ve-mobile-sm__flex-col">
		<div class="ve-flex-v-center ve-mr-2 ve-mobile-sm__mb-2 ve-mobile-sm__mr-0">
			<button type="button" class="ve-btn ve-btn-default ve-btn-xs ve-mr-2" id="btn-book">查看原文</button>
			<button type="button" class="ve-btn ve-btn-default ve-btn-xs" id="btn-show-table" title="View and Download Spells in Tabular Format">查看表格</button>
		</div>

		<div class="ve-flex-v-center ve-mobile-sm__mb-2">
			{{> "btngroupManager" }}

			<button type="button" class="ve-btn ve-btn-default ve-btn-xs ve-ml-2" id="btn-list-settings" title="设置"><span class="glyphicon glyphicon-cog"></span></button>
		</div>
	</div>
</div>
