<script>
	(() => {
		let isLoaded = false;
		let fallbackTimeout = null;
		const loadScript = () => {
			if (isLoaded) return;
			isLoaded = true;
			if (fallbackTimeout != null) window.clearTimeout(fallbackTimeout);
			const script = document.createElement("script");
			script.src = "https://finicounter.eu.org/finicounter.js";
			script.async = true;
			document.head.appendChild(script);
		};

		window.addEventListener("toolsLoaded", loadScript, {once: true});
		window.addEventListener("load", () => {
			if (!isLoaded) fallbackTimeout = window.setTimeout(loadScript, 5000);
		}, {once: true});
	})();
</script>
